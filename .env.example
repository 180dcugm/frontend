# Local development environment. Copy to .env and fill in the blanks:
#   cp .env.example .env
# .env is gitignored. Never commit real values, and never put production values here.

# ---------------------------------------------------------------------------
# Payload (required)
# ---------------------------------------------------------------------------

# Local Docker Postgres (see README, "Local development").
# NEVER the production URL: `pnpm dev` runs Payload in push mode, which changes the schema of
# whatever database this points at to match your branch, without asking for additive changes.
POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/payload

# Any long random string for local use, e.g. the output of `openssl rand -hex 32`.
PAYLOAD_SECRET=

# Store uploads in ./media instead of the production S3 bucket.
PAYLOAD_LOCAL_UPLOADS=true

NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (required to start)
# ---------------------------------------------------------------------------
# src/collections/AIKnowledge.ts creates a Supabase client when the Payload config loads, so
# both must be set. Use the dev Supabase project's URL and anon key (ask IT).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Optional: only for the features that use them. Leave unset unless you are working on one.
# ---------------------------------------------------------------------------

# Supabase service role: dashboard, registrations, oprec and store API routes
# SUPABASE_SERVICE_ROLE_KEY=
# Fallback for NEXT_PUBLIC_SUPABASE_URL in AIKnowledge.ts only
# SUPABASE_URL=

# AI Knowledge embeddings and the Eighty chatbot
# GOOGLE_API_KEY=
# GROQ_API_KEY=

# Google OAuth: src/lib/googleAuth.ts and Gmail for registration emails
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_REFRESH_TOKEN=

# Google Sheets (oprec submissions)
# GOOGLE_SHEETS_ID=
# GOOGLE_SHEETS_API_KEY=
# GOOGLE_SHEETS_CREDENTIALS=
# GOOGLE_SHEETS_CONSULTING_TAB=
# GOOGLE_SHEETS_CONSULTING_2627_TAB=
# GOOGLE_SHEETS_FUNCTIONAL_2627_TAB=

# Registration and confirmation emails
# APP_EMAIL=
# APAC_EMAIL=
# APP_MAIL_REFRESH_TOKEN=

# Midtrans payments (store); use the sandbox keys locally
# MIDTRANS_IS_PRODUCTION=false
# MIDTRANS_CLIENT_KEY_SB=
# MIDTRANS_SERVER_KEY_SB=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_SERVER_KEY=
# EVENT_CODE=

# Protects the case competition cron route
# CRON_SECRET=

# Production only, do not set locally: S3_BUCKET, S3_ENDPOINT, S3_REGION, S3_ACCESS_KEY_ID,
# S3_SECRET_ACCESS_KEY. Locally, PAYLOAD_LOCAL_UPLOADS=true replaces them.
